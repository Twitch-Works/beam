# API base URL — no trailing slash (set prod URL in Vercel dashboard)
NEXT_PUBLIC_APP_MODE=development
NEXT_PUBLIC_API_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Which roles this deployment serves — 'admin' (ops: admin/super_admin only),
# 'partner' (teacher self-service only). Leave unset to allow both (default).
NEXT_PUBLIC_USER_ENV=admin
